  "components": {
    "schemas": {
      "EntityTypeEnum": {
        "enum": ["actor", "genre"],
        "type": "string",
        "description": "* `actor` - actor\n* `genre` - genre"
      },
      "SearchQuery": {
        "type": "object",
        "properties": {
          "entity_type": {
            "$ref": "#/components/schemas/EntityTypeEnum"
          },
          "entity_id": {
            "type": "integer",
            "minimum": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "page_size": {
            "type": "integer",
            "maximum": 100,
            "minimum": 1,
            "default": 20
          },
          "ordering": {
            "type": "string",
            "default": "-views"
          },
          "force_refresh": {
            "type": "boolean",
            "default": false
          },
          "source": {
            "$ref": "#/components/schemas/SourceEnum"
          }
        },
        "required": ["entity_id", "entity_type"]
