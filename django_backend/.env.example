# Django 配置
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis 配置（如果需要自定义）
REDIS_URL=redis://localhost:6379/0

# Online playback remains opt-in until target environment acceptance.
NASSAV_PLAYBACK_ENABLED=false

# Comma-separated exact CDN hosts or *.approved-domain patterns; empty denies all.
NASSAV_PLAYBACK_ALLOWED_HOSTS=
# Only true after verifying remote-proxy target ACL/DNS policy.
NASSAV_PLAYBACK_PROXY_TARGETS_TRUSTED=false
NASSAV_PLAYBACK_MAX_MEDIA_REQUESTS=16

# Managed admission remains closed until cutover acceptance and account bootstrap.
NASSAV_SCOPED_SOURCE_CREDENTIALS=false
NASSAV_SOURCE_CREDENTIAL_KEYRING_FILE=
NASSAV_SHARED_LIBRARY_ENABLED=false
NASSAV_MULTI_USER_ENABLED=false

# Keep physical resource GC disabled until the shared-library acceptance gate.
NASSAV_RESOURCE_GC_ENABLED=false
NASSAV_RESOURCE_GC_BATCH_SIZE=32
