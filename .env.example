# Copy to .env. Generate a unique value with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret
NASSAV_IMAGE_TAG=local
NASSAV_DATA_DIR=./deploy-data
# Match the host account: id -u / id -g; all backend services share this identity.
NASSAV_UID=1000
NASSAV_GID=1000
# Compose mode is selected by files and declared once in NASSAV_DATA_DIR/db/.nassav-db-mode.
# Run scripts/compose_stack.py --mode sqlite|postgres init before the first up.
# Do not set DB_ENGINE here; DB_HOST/DB_PORT/DB_NAME/DB_USER apply only with the overlay.
DB_HOST=host.docker.internal
DB_PORT=5432
# Optional; defaults to Database.Schema from config.yaml or public.
DB_SCHEMA=
DB_NAME=nassav
DB_USER=nassav
# Create this file manually with the external database password; keep it out of Git.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
# Set to: realpath deploy-data/resource/video
NASSAV_VIDEO_HOST_DIR=
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=9780
ALLOWED_HOSTS=localhost,127.0.0.1,api
NASSAV_OPERATOR_USERNAME=nassav
NASSAV_SECURE_COOKIES=false
CSRF_TRUSTED_ORIGINS=
# Optional fallback when a Byparr request has no project Proxy.url header.
BYPARR_PROXY_SERVER=
# Set to http://ollama:11434 when using --profile translator; otherwise leave empty.
OLLAMA_URL=

# Online playback remains opt-in until target environment acceptance.
NASSAV_PLAYBACK_ENABLED=false

# Comma-separated exact CDN hosts or *.approved-domain patterns; empty denies all.
NASSAV_PLAYBACK_ALLOWED_HOSTS=
# Only true after verifying remote-proxy target ACL/DNS policy.
NASSAV_PLAYBACK_PROXY_TARGETS_TRUSTED=false
NASSAV_PLAYBACK_MAX_MEDIA_REQUESTS=16

# Keep physical resource GC disabled until the shared-library acceptance gate.
NASSAV_RESOURCE_GC_ENABLED=false
NASSAV_RESOURCE_GC_BATCH_SIZE=32
