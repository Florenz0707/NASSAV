# Copy to .env. Generate a unique value with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret
NASSAV_IMAGE_TAG=local
NASSAV_DATA_DIR=./deploy-data
# Default local/Compose database; use compose.postgres.yaml for an external PostgreSQL server.
DB_ENGINE=sqlite
DB_HOST=host.docker.internal
DB_PORT=5432
# Optional; defaults to Database.Schema from config.yaml or public.
DB_SCHEMA=
DB_NAME=nassav
DB_USER=nassav
# Create this file manually with the external database password; keep it out of Git.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
# Set to: realpath deploy-data/resource/video
NASSAV_VIDEO_HOST_DIR=
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=9780
ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=
# Optional fallback when a Byparr request has no project Proxy.url header.
BYPARR_PROXY_SERVER=
# Set to http://ollama:11434 when using --profile translator; otherwise leave empty.
OLLAMA_URL=
